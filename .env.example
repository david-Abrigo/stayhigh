# URL de la API del Backend (en producción será la URL asignada por Render)
VITE_API_URL=https://tu-backend.onrender.com

# URL pública de este frontend (usada para generar el enlace dentro del QR)
VITE_PUBLIC_URL=https://tu-checkout.onrender.com

# URL base del proyecto Supabase (sin /rest/v1)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (NUNCA incluir la service_role)
VITE_SUPABASE_ANON_KEY=tu_anon_key

# Modo Demostración/Simulación (true para probar sin backend, false en producción)
VITE_MOCK_MODE=true
